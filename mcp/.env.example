# Copy to .env (or set these in your MCP client config) and fill in your token.

# API key from Corvos (Settings -> API). Required.
CORVOS_API_KEY=ss_pat_your_token_here

# Base URL of the Corvos backend. Defaults to http://localhost:8000
CORVOS_BASE_URL=http://localhost:8000

# Optional: default workspace (search space) by name or id, so you don't have
# to select one each session.
# CORVOS_WORKSPACE=My Research Space

# Optional overrides.
# CORVOS_API_PREFIX=/api/v1
# CORVOS_TIMEOUT=180
# CORVOS_MCP_TRANSPORT=stdio
